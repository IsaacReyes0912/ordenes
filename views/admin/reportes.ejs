<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin — Reportes</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
</head>
<body>

<div class="admin-topbar">
  <h1>🍔 Admin — Reportes</h1>
  <div style="display:flex; gap:.8rem; align-items:center;">
    <a href="/admin" style="color:#ccc; text-decoration:none; font-size:.9rem;">← Pedidos</a>
    <a href="/admin/logout" class="btn btn-outline btn-sm" style="color:#fff; border-color:#fff;">Salir</a>
  </div>
</div>

<div class="admin-container">

  <!-- Tarjetas de resumen -->
  <div class="stats-bar">
    <div class="stat-card">
      <div class="stat-num">$<%= resumen.ingresos %></div>
      <div class="stat-label">💰 Ingresos totales</div>
    </div>
    <div class="stat-card">
      <div class="stat-num"><%= resumen.totalPedidos %></div>
      <div class="stat-label">📦 Pedidos totales</div>
    </div>
    <div class="stat-card">
      <div class="stat-num"><%= resumen.pedidosHoy %></div>
      <div class="stat-label">📅 Pedidos hoy</div>
    </div>
    <div class="stat-card">
      <div class="stat-num">$<%= resumen.ticketPromedio %></div>
      <div class="stat-label">🎯 Ticket promedio</div>
    </div>
    <div class="stat-card">
      <div class="stat-num"><%= resumen.totalClientes %></div>
      <div class="stat-label">👥 Clientes registrados</div>
    </div>
  </div>

  <!-- Gráficas -->
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; margin-top:1.5rem;">

    <!-- Ventas por día -->
    <div class="detail-card">
      <h3>📈 Ventas últimos 7 días</h3>
      <canvas id="chartVentas"></canvas>
    </div>

    <!-- Productos más vendidos -->
    <div class="detail-card">
      <h3>🏆 Productos más vendidos</h3>
      <canvas id="chartProductos"></canvas>
    </div>

  </div>

  <!-- Pedidos por estado -->
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; margin-top:1.5rem;">

    <div class="detail-card">
      <h3>🥧 Pedidos por estado</h3>
      <canvas id="chartEstados"></canvas>
    </div>

    <div class="detail-card">
      <h3>📋 Últimos 5 pedidos</h3>
      <table style="width:100%; border-collapse:collapse; font-size:.9rem;">
        <thead>
          <tr style="background:#f4f4f4;">
            <th style="padding:.6rem; text-align:left;">#</th>
            <th style="padding:.6rem; text-align:left;">Cliente</th>
            <th style="padding:.6rem; text-align:right;">Total</th>
            <th style="padding:.6rem; text-align:center;">Estado</th>
          </tr>
        </thead>
        <tbody>
          <% ultimosPedidos.forEach(order => { %>
          <tr style="border-bottom:1px solid #eee;">
            <td style="padding:.6rem;">#<%= order.id %></td>
            <td style="padding:.6rem;"><%= order.customer_name %></td>
            <td style="padding:.6rem; text-align:right; color:#e85d04; font-weight:700;">
              $<%= parseFloat(order.total).toFixed(2) %>
            </td>
            <td style="padding:.6rem; text-align:center;">
              <span class="badge-status badge-<%= order.status %>">
                <%= order.status.replace('_',' ') %>
              </span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  </div>
</div>

<script>
  // ── Gráfica: Ventas por día ──────────────────────
  const ventasData = <%- JSON.stringify(ventasPorDia) %>;
  new Chart(document.getElementById('chartVentas'), {
    type: 'line',
    data: {
      labels: ventasData.map(d => d.fecha),
      datasets: [{
        label: 'Ingresos ($)',
        data: ventasData.map(d => d.total),
        borderColor: '#e85d04',
        backgroundColor: 'rgba(232,93,4,0.1)',
        borderWidth: 2,
        fill: true,
        tension: 0.4
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: { y: { beginAtZero: true } }
    }
  });

  // ── Gráfica: Productos más vendidos ─────────────
  const productosData = <%- JSON.stringify(productosMasVendidos) %>;
  new Chart(document.getElementById('chartProductos'), {
    type: 'bar',
    data: {
      labels: productosData.map(p => p.nombre),
      datasets: [{
        label: 'Unidades vendidas',
        data: productosData.map(p => p.cantidad),
        backgroundColor: [
          '#e85d04','#f4a261','#e9c46a','#2a9d8f','#264653','#e76f51'
        ],
        borderRadius: 6
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: { y: { beginAtZero: true } }
    }
  });

  // ── Gráfica: Pedidos por estado ──────────────────
  const estadosData = <%- JSON.stringify(pedidosPorEstado) %>;
  new Chart(document.getElementById('chartEstados'), {
    type: 'doughnut',
    data: {
      labels: estadosData.map(e => e.status),
      datasets: [{
        data: estadosData.map(e => e.total),
        backgroundColor: ['#e9c46a','#2196f3','#2d6a4f','#d62828'],
        borderWidth: 2
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { position: 'bottom' } }
    }
  });
</script>

</body>
</html>