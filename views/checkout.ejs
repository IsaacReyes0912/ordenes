<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout — Pedidos Online</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
  <a href="/" class="brand">🍔 Pedidos Online</a>
  <div class="nav-links">
    <% if (currentUser) { %>
      <a href="/mi-cuenta" style="color:#fff;">👤 <%= currentUser.name %></a>
      <a href="/logout">Cerrar sesión</a>
    <% } else { %>
      <a href="/login">Iniciar sesión</a>
      <a href="/registro">Registrarse</a>
    <% } %>
  </div>
</nav>

<div class="container">
  <div class="checkout-wrapper">
    <h2>📋 Completa tu pedido</h2>

    <% if (!currentUser) { %>
    <div style="background:#fff3cd; border:1px solid #ffc107; border-radius:8px; padding:.9rem 1rem; margin-bottom:1.2rem; font-size:.9rem;">
      💡 <strong>¿Tienes cuenta?</strong>
      <a href="/login?next=/checkout" style="color:var(--primary); font-weight:600;">Inicia sesión</a>
      para que tus datos se llenen automáticamente.
    </div>
    <% } %>

    <div class="order-summary">
      <h3>Tu pedido:</h3>
      <div id="summary-items">
        <p style="color:#999; font-size:.9rem;">Cargando carrito…</p>
      </div>
      <div class="summary-total">
        <span>Total:</span>
        <span id="summary-total">$0.00</span>
      </div>
    </div>

    <form method="POST" action="/checkout" id="checkout-form">
      <input type="hidden" name="items" id="items-json">

      <div class="form-group">
        <label for="customer_name">Nombre completo *</label>
        <input type="text" id="customer_name" name="customer_name"
               placeholder="Juan García" required
               value="<%= prefill ? (prefill.name || '') : '' %>">
      </div>

      <div class="form-group">
        <label for="phone">Teléfono *</label>
        <input type="tel" id="phone" name="phone"
               placeholder="55 1234 5678" required
               value="<%= prefill ? (prefill.phone || '') : '' %>">
      </div>

      <div class="form-group">
        <label for="address">Dirección de entrega *</label>
        <input type="text" id="address" name="address"
               placeholder="Calle, número, colonia, ciudad" required
               value="<%= prefill ? (prefill.address || '') : '' %>">
      </div>

      <div class="form-group">
        <label for="notes">Notas adicionales</label>
        <textarea id="notes" name="notes"
                  placeholder="Sin cebolla, tocar timbre dos veces, etc."></textarea>
      </div>

      <button type="submit" class="btn btn-primary btn-full" id="submit-btn">
        ✅ Confirmar pedido (pago en efectivo)
      </button>

      <div style="text-align:center; margin:1rem 0; color:#aaa; font-size:.9rem;">
        — o paga en línea con —
      </div>

      <div id="paypal-button-container"></div>

      <a href="/" class="btn btn-outline btn-full" style="margin-top:.8rem;">
        ← Seguir comprando
      </a>
    </form>
  </div>
</div>

<script>
  function getCart() {
    try { return JSON.parse(localStorage.getItem('pedidos_cart')) || []; }
    catch { return []; }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const cart = getCart();

    if (cart.length === 0) {
      window.location.href = '/?error=carrito_vacio';
      return;
    }

    const summaryEl = document.getElementById('summary-items');
    const totalEl   = document.getElementById('summary-total');
    let total = 0;

    summaryEl.innerHTML = cart.map(item => {
      const subtotal = item.price * item.qty;
      total += subtotal;
      return `<div class="summary-item">
        <span>${item.qty}× ${item.name}</span>
        <span>$${subtotal.toFixed(2)}</span>
      </div>`;
    }).join('');

    totalEl.textContent = '$' + total.toFixed(2);

    document.getElementById('checkout-form').addEventListener('submit', (e) => {
      const itemsJson = JSON.stringify(cart.map(i => ({
        id:  i.id,
        qty: i.qty
      })));
      document.getElementById('items-json').value = itemsJson;
      document.getElementById('submit-btn').disabled = true;
      document.getElementById('submit-btn').textContent = 'Procesando…';
      localStorage.removeItem('pedidos_cart');
    });
  });
</script>

<script src="https://www.paypal.com/sdk/js?client-id=AdlcbqjG5tbELES-tqQn34kjd6fhnNymeI6_wHAJRg1Iz3sgMkxOgLtUk2qzFZfXwI2rpA5urkszFr2n&currency=USD"></script>
<script>
  paypal.Buttons({
    createOrder: async () => {
      const cart = getCart();
      const total = cart.reduce((s, i) => s + i.price * i.qty, 0);

      const res = await fetch('/paypal/crear-orden', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ total: total.toFixed(2) })
      });
      const data = await res.json();
      return data.id;
    },

    onApprove: async (data) => {
      const cart = getCart();
      const total = cart.reduce((s, i) => s + i.price * i.qty, 0);

      const customer_name = document.getElementById('customer_name').value;
      const phone         = document.getElementById('phone').value;
      const address       = document.getElementById('address').value;
      const notes         = document.getElementById('notes').value;

      if (!customer_name || !phone || !address) {
        alert('Por favor completa tu nombre, teléfono y dirección antes de pagar.');
        return;
      }

      const items = JSON.stringify(cart.map(i => ({ id: i.id, qty: i.qty })));

      const res = await fetch('/paypal/capturar-orden', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          paypalOrderId: data.orderID,
          pedidoData: { customer_name, phone, address, notes, items, total: total.toFixed(2) }
        })
      });

      const result = await res.json();
      if (result.success) {
        localStorage.removeItem('pedidos_cart');
        window.location.href = '/confirmation/' + result.orderId;
      } else {
        alert('Error al procesar el pago: ' + result.error);
      }
    },

    onError: (err) => {
      console.error('Error PayPal:', err);
      alert('Ocurrió un error con PayPal. Intenta de nuevo.');
    }
  }).render('#paypal-button-container');
</script>

</body>
</html>