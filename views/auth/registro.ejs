<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crear cuenta — Pedidos Online</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body style="background:#f0f0f0;">

<div class="login-box" style="max-width:440px;">
  <div style="font-size:2.5rem; margin-bottom:.5rem;">📝</div>
  <h1>Crear cuenta</h1>
  <p>Regístrate para hacer pedidos más rápido</p>

  <% if (error) { %>
    <div class="login-error"><%= error %></div>
  <% } %>

  <form method="POST" action="/registro">

    <div class="form-group" style="text-align:left;">
      <label for="name">Nombre completo *</label>
      <input type="text" id="name" name="name"
             placeholder="Juan García" required
             value="<%= values.name || '' %>">
    </div>

    <div class="form-group" style="text-align:left;">
      <label for="email">Correo electrónico *</label>
      <input type="email" id="email" name="email"
             placeholder="tucorreo@ejemplo.com" required
             value="<%= values.email || '' %>">
    </div>

    <div class="form-group" style="text-align:left;">
      <label for="phone">Teléfono <span style="color:#aaa; font-weight:400;">(opcional)</span></label>
      <input type="tel" id="phone" name="phone"
             placeholder="55 1234 5678"
             value="<%= values.phone || '' %>">
    </div>

    <div class="form-group" style="text-align:left;">
      <label for="address">Dirección <span style="color:#aaa; font-weight:400;">(opcional)</span></label>
      <input type="text" id="address" name="address"
             placeholder="Calle, número, colonia, ciudad"
             value="<%= values.address || '' %>">
    </div>

    <div class="form-group" style="text-align:left;">
      <label for="password">Contraseña *</label>
      <input type="password" id="password" name="password"
             placeholder="Mínimo 6 caracteres" required minlength="6">
    </div>

    <div class="form-group" style="text-align:left;">
      <label for="password2">Confirmar contraseña *</label>
      <input type="password" id="password2" name="password2"
             placeholder="Repite tu contraseña" required>
    </div>

    <button type="submit" class="btn btn-primary btn-full">Crear cuenta</button>
  </form>

  <p style="margin-top:1.2rem; font-size:.9rem; color:#666;">
    ¿Ya tienes cuenta?
    <a href="/login" style="color:var(--primary); font-weight:600;">Inicia sesión</a>
  </p>
  <p style="margin-top:.5rem; font-size:.85rem;">
    <a href="/" style="color:#aaa;">← Volver al menú</a>
  </p>
</div>

</body>
</html>